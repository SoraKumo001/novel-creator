# データベース接続文字列
DATABASE_URL=postgres://novel:novel@localhost:5433/novel

# === LLM (テキスト生成) ===
# LLMプロバイダー (openai | anthropic | ollama | google)
LLM_PROVIDER=openai

# LLM APIキー (ollama-localの場合は不要)
LLM_API_KEY=

# LLMモデル名
LLM_MODEL=gpt-4o-mini

# LLMベースURL (オプション、プロキシやOllama/OllamaCloud等で使用)
# OllamaCloud の場合: https://ollama.com/v1
LLM_BASE_URL=

# === Embedding (ベクトル生成) ===
# 未設定の場合は LLM_* の設定をフォールバック使用します。
# LLMと別プロバイダを使用したい場合のみ設定してください。

# Embeddingプロバイダー (openai | anthropic | ollama | google)
# EMBEDDING_PROVIDER=openai

# Embedding APIキー (未設定時は LLM_API_KEY を使用)
# EMBEDDING_API_KEY=

# 埋め込みモデル名
EMBEDDING_MODEL=text-embedding-3-small

# EmbeddingベースURL (未設定時は LLM_BASE_URL を使用)
# EMBEDDING_BASE_URL=

# === OpenAI互換ローカルLLM (custom_openai) の例 ===
# LM Studio: http://localhost:1234/v1 / vLLM: http://localhost:8000/v1 / llama.cpp: http://localhost:8080/v1 / Ollama: http://localhost:11434/v1
# Dockerからホスト側のローカルLLMに接続する場合は localhost の代わりに host.docker.internal を使用すること。
# LLM_PROVIDER=custom_openai
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=local-model
# EMBEDDING_PROVIDER=custom_openai
# EMBEDDING_BASE_URL=http://localhost:1234/v1
# EMBEDDING_MODEL=local-embed-model

# === Vector Store ===
# VectorStoreプロバイダー (pgvector | vectorize)
VECTOR_STORE_PROVIDER=pgvector

# 実行環境 (development | production | test)
NODE_ENV=development

# === Master Secret (認証・APIキー暗号化の単一鍵) ===
# better-auth のセッション署名と llm_configs / embedding_configs の api_key 暗号化保存 (AES-GCM)
# の双方を HKDF(SHA-256) で導出する単一マスター鍵。必須。未設定の場合、API は起動しない。
# 生成例: 
#  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (Node: .env / Cloudflare Workers: wrangler secret put MASTER_SECRET)。
MASTER_SECRET=

# better-auth のベース URL (API の公開 URL。Cookie 発行等に使用)
BETTER_AUTH_URL=http://localhost:3000

# Web フロントのオリジン (CORS の許可オリジン)
WEB_ORIGIN=http://localhost:5173

# === Google OAuth 認証 (オプション) ===
# Googleアカウントによるログイン・オープンサインアップを有効化する場合に設定します。
# Google Cloud Console の「APIとサービス」>「認証情報」から OAuth 2.0 クライアントを作成し、
# 承認済みのリダイレクト URI に以下を登録してください:
#   ローカル開発: http://localhost:3000/api/auth/callback/google
#   本番環境:     https://<本番ドメイン>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
