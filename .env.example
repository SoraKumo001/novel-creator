# データベース接続文字列
DATABASE_URL=postgres://novel:novel@localhost:5433/novel

# === LLM (テキスト生成) ===
# LLMプロバイダー (openai | anthropic | ollama | google)
LLM_PROVIDER=openai

# LLM APIキー (ollama-localの場合は不要)
LLM_API_KEY=

# LLMモデル名
LLM_MODEL=gpt-4o-mini

# LLMベースURL (オプション、プロキシやOllama/OllamaCloud等で使用)
# OllamaCloud の場合: https://ollama.com/v1
LLM_BASE_URL=

# === Embedding (ベクトル生成) ===
# 未設定の場合は LLM_* の設定をフォールバック使用します。
# LLMと別プロバイダを使用したい場合のみ設定してください。

# Embeddingプロバイダー (openai | anthropic | ollama | google)
# EMBEDDING_PROVIDER=openai

# Embedding APIキー (未設定時は LLM_API_KEY を使用)
# EMBEDDING_API_KEY=

# 埋め込みモデル名
EMBEDDING_MODEL=text-embedding-3-small

# EmbeddingベースURL (未設定時は LLM_BASE_URL を使用)
# EMBEDDING_BASE_URL=

# === Vector Store ===
# VectorStoreプロバイダー (pgvector | vectorize)
VECTOR_STORE_PROVIDER=pgvector

# 実行環境 (development | production | test)
NODE_ENV=development

# === Auth (better-auth) ===
# セッション署名用の秘密鍵。本番では必ず secrets 運用で設定すること
# (Node: .env / Cloudflare Workers: wrangler secret put BETTER_AUTH_SECRET)。
# 未設定の場合は認証ミドルウェアが素通りになるため開発用途に限定すること。
BETTER_AUTH_SECRET=

# better-auth のベース URL (API の公開 URL。Cookie 発行等に使用)
BETTER_AUTH_URL=http://localhost:3000

# Web フロントのオリジン (CORS の許可オリジン)
WEB_ORIGIN=http://localhost:5173
