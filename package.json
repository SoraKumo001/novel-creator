{
  "name": "novel-creator",
  "version": "0.0.0",
  "private": true,
  "repository": "https://github.com/SoraKumo001/novel-creator",
  "license": "MIT",
  "author": "SoraKumo <info@croud.jp>",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "pnpm -r build",
    "build-storybook": "pnpm --filter @novel-creator/web build-storybook",
    "check": "ultracite check",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @novel-creator/db db:generate",
    "db:migrate": "pnpm --filter @novel-creator/db db:migrate",
    "db:push": "pnpm --filter @novel-creator/db db:push",
    "db:studio": "pnpm --filter @novel-creator/db db:studio",
    "db:up": "docker compose up -d",
    "deploy:api": "pnpm --filter @novel-creator/api deploy",
    "deploy:web": "pnpm --filter @novel-creator/web deploy",
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @novel-creator/api dev",
    "dev:web": "pnpm --filter @novel-creator/web dev",
    "dev:worker": "pnpm --filter @novel-creator/api dev:worker",
    "fix": "ultracite fix",
    "format": "ultracite fix",
    "lint": "ultracite check",
    "preview": "pnpm --filter @novel-creator/web preview",
    "preview:web": "pnpm --filter @novel-creator/web preview",
    "setup:db": "docker compose up -d && pnpm --filter @novel-creator/db db:push",
    "start": "pnpm --filter @novel-creator/api start",
    "start:api": "pnpm --filter @novel-creator/api start",
    "storybook": "pnpm --filter @novel-creator/web storybook",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r typecheck"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,jsonc,css,md,yaml,yml,html}": [
      "ultracite fix"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@vitest/coverage-v8": "^4.1.11",
    "husky": "^9.0.0",
    "lint-staged": "^17.4.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript7": "npm:typescript@^7.0.2",
    "ultracite": "7.10.7",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
