{
  "name": "@novel-creator/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:worker": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "dev": "node --import tsx --watch src/index.ts",
    "dev:worker": "wrangler dev",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.0",
    "@novel-creator/db": "workspace:*",
    "@novel-creator/llm": "workspace:*",
    "@novel-creator/shared": "workspace:*",
    "@novel-creator/vector": "workspace:*",
    "ai": "7.0.84",
    "dotenv": "17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260829.1",
    "@types/node": "^26.4.0",
    "tsx": "^4.19.0",
    "wrangler": "^4.127.1"
  }
}
