{
  "name": "novel-creator",
  "main": "src/worker.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "ae06ed29802e41e5b590d3957d819a72",
      "localConnectionString": "postgres://novel:novel@localhost:5433/novel"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "VECTORIZE_INDEX",
      "index_name": "novel-creator-embeddings"
    }
  ],
  "vars": {
    "LLM_PROVIDER": "openai",
    "LLM_MODEL": "gpt-4o-mini",
    "EMBEDDING_PROVIDER": "workers-ai",
    "EMBEDDING_MODEL": "@cf/baai/bge-m3",
    "EMBEDDING_DIMENSIONS": "1024",
    "VECTOR_STORE_PROVIDER": "vectorize"
    // NOTE: MASTER_SECRET は secrets 運用 (`wrangler secret put MASTER_SECRET`)。
  }
}
